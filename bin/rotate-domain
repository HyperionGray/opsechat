#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export OPSECHAT_DOMAIN_CLI_CMD="bin/rotate-domain"
export OPSECHAT_DOMAIN_CLI_ALIAS="rotate-domain"
export OPSECHAT_DOMAIN_CLI_PROG="rotate-domain"
exec python3 "${SCRIPT_DIR}/domain_rotation_cli.py" "$@"
